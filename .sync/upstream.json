{
  "$comment": "上流との同期マニフェスト。仕様は docs/fork-sync.md を参照。include/exclude は tools/sync-upstream.mjs が **/*/? のみ解釈する簡易 glob。不変則: ツールを exclude したら、そのツールのテストも必ず exclude する（取り込むと npm test が確実に壊れるため）。docs/fork-sync.md・docs/deploy-howto.md は本リポジトリで意図的に書き換えているため除外。tests/ の後半ブロックは上流の実データ（Works_NumberTales 等）を前提とするテストで、Works_Sample しか持たない本リポジトリでは通らないため除外。",
  "name": "creationsdb",
  "repo": "https://github.com/radiann-kswg/100BeautiesLab_CreationsDB.git",
  "remote": "upstream",
  "branch": "develop",
  "vendorBranch": "upstream/creationsdb",
  "include": [
    ".gitattributes",
    "api/**",
    "docs/**",
    "lib/**",
    "pages/**",
    "pkg/**",
    "svc/**",
    "tests/**",
    "tools/**",
    "vitest.config.js"
  ],
  "exclude": [
    "**/CNAME",
    "docs/README.md",
    "docs/localization-glossary-quickref.md",
    "pkg/cloudflare/wrangler.toml",
    "tools/agent-instructions/**",
    "tools/build-calendar-ics.mjs",
    "tools/sync-calendar-gcal.mjs",
    "tools/inject-conversation-patterns.mjs",
    "tools/normalize-callings.mjs",
    "tools/patch-*.mjs",

    "tests/calendar.*",
    "tests/conversation-pattern.test.js",
    "tests/data.roleplay-prompts.test.js",
    "tests/patch-*.test.js",

    "docs/fork-sync.md",
    "docs/deploy-howto.md",

    "tests/baseArea.render.test.js",
    "tests/commons.secondaries.test.js",
    "tests/data.shape.test.js",
    "tests/enrich.dblink.jump.merge.test.js",
    "tests/enrich.index-alias-dict.test.js",
    "tests/enrich.indexdef.perdb.test.js",
    "tests/faction.render.test.js",
    "tests/image-dir-mapping.test.js",
    "tests/keyedDialogue.render.test.js",
    "tests/legacy-work-alias.test.js",
    "tests/migrate-common.test.js",
    "tests/pages.characters.ui-output.test.js",
    "tests/pages.characters.url-params.test.js",
    "tests/pkg.nodejs.test.js",
    "tests/private-commons-order.test.js",
    "tests/section-renders.relation.test.js"
  ]
}
