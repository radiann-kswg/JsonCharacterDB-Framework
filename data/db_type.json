      "hashTag_EN": "ANOTHER-REGIONs",
      "$enrich": true
    },
    {
      "$slot": "#SecondaryMeta",
      "$slotExpand": "$MetaType.$Def_SecondaryMeta",
      "$slotNote": "二次創作メタ(sec_*)は $Def_SecondaryMeta の宣言順をここへ展開する。トップレベル $DefType へ再掲すると二重管理になるため参照で解決する"
    },
    {
      "$slot": "#WorkDBLinkRef",
      "$slotMatch": { "$typeIncludes": "$Def_DBLinkRef" },
      "$slotNote": "作品固有の _DBLink 参照(SameModels_DBLink 等)をグローバル _DBLink 群の直後へ。$type が配列(インライン構造体)のエントリには一致しない"
    },
    {
      "hashTag": "Name_JP",
      "$type": "##String_JP|#Null",
      "hashTag_JP": "愛称"
    },
    {
      "hashTag": "Name_JPReading",
