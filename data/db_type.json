{
  "$DefType": [
    {
      "$slot": "#Index",
      "$slotMatch": { "$type": "#Index" },
      "$slotNote": "作品ごとに hashTag が異なる主インデックス(Num/Card/Unit/BeastType/Drc/Letter/Model/Chronos/Virtues 等)を先頭へ寄せる。複数宣言している作品は作品側の宣言順を保つ"
    },
    {
      "hashTag": "Progress",
      "$type": "$EnumDef",
      "hashTag_JP": "進捗",
      "hashTag_EN": "Creation Progress",
      "$display": {
        "section": "basic",
        "tagSpace": "creatorProgress",
        "facet": { "order": 40 }
      }
    },
    {
      "hashTag": "AnotherVersions_DBLink",
